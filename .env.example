# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env lên git.

# --- Bắt buộc ---
# Tạo khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# development | production
APP_ENV=development
# Tên miền hợp lệ của web (production: tên miền thật, ví dụ clb.example.com)
TRUSTED_HOSTS=localhost,127.0.0.1,::1
APP_TIMEZONE=Asia/Bangkok
# Mặc định SQLite trong instance/clb.db. PostgreSQL: postgresql://user:pass@host/dbname
# DATABASE_URL=

# --- Chạy sau Nginx (production) ---
# Số reverse proxy đứng trước app (Nginx = 1). 0 khi chạy trực tiếp.
TRUST_PROXY_HOPS=0
# strong (khuyến nghị) | basic
SESSION_PROTECTION=strong
REMEMBER_DAYS=14

# --- Rate limit (Flask-Limiter) ---
RATELIMIT_ENABLED=true
# memory:// cho 1 process; nhiều worker Gunicorn: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
API_RATE_LIMIT=120 per minute
AUTH_RATE_LIMIT=20 per minute

# --- Email (SMTP) ---
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Gmail: MAIL_USERNAME là địa chỉ Gmail, MAIL_PASSWORD là App Password 16 ký tự (bật xác minh 2 bước trước)
MAIL_USERNAME=
MAIL_PASSWORD=
# Địa chỉ trần hoặc có tên hiển thị, nên trùng MAIL_USERNAME: "FIA Club <fia.clb@gmail.com>"
MAIL_DEFAULT_SENDER=
# Chỉ development: lưu thư vào instance/mail_outbox/*.eml thay vì gửi (để lấy link xác minh/đặt lại mật khẩu)
MAIL_OUTBOX=false

# --- Scheduler (job nhắc deadline/kỳ quỹ) ---
SCHEDULER_ENABLED=true
# false khi chạy Gunicorn nhiều worker; khi đó chạy riêng: flask --app run.py run-scheduler
SCHEDULER_IN_WEB=true
# Sự kiện tự chuyển "Đã kết thúc" sau giờ kết thúc bấy nhiêu giờ (BĐH vẫn kết thúc sớm được)
EVENT_AUTO_CLOSE_HOURS=24
# Rà soát trạng thái sự kiện khi có người mở web (tối đa 1 lần / EVENT_STATUS_SYNC_SECONDS giây)
EVENT_STATUS_AUTO_SYNC=true
EVENT_STATUS_SYNC_SECONDS=60

# --- Trợ lý AI ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_CALLS_PER_MINUTE=12
AI_DAILY_TOKEN_LIMIT=100000
AI_CHAT_MESSAGES_PER_MINUTE=20
AI_STRICT_FACTS=true
AI_AGENT_ENABLED=true
AI_AGENT_MAX_STEPS=3
AI_AGENT_MAX_SECONDS=90
# Câu hỏi một ý: trả lời ngay sau 1 lượt chọn công cụ (tiết kiệm quota)
AI_AGENT_FAST_FINISH=true
# Model viết câu trả lời từ dữ liệu thật; con số sai lệch sẽ bị loại
AI_AGENT_COMPOSE=true
# Dùng Claude: AI_PROVIDER=anthropic, AI_API_KEY=..., AI_MODEL=...
# AI_API_KEY=
# AI_MODEL=
# AI_WORKSPACE_ID=

# --- Chỉ cho máy phát triển ---
# FLASK_DEBUG=1
